datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Appointment {
  id             Int      @id @default(autoincrement())
  clientId       Int
  appointmentDate DateTime
  service        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Client {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  createdAt DateTime @default(now())
}

